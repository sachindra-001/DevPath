# =============================================================================
# CPGS — Career Path Guidance System · environment contract (DESIGN.md §11.3, §32.2)
# Copy to `.env` and adjust. NEVER commit real secrets.
# =============================================================================

# --- Postgres (used by docker-compose interpolation) ---
POSTGRES_USER=cpgs
POSTGRES_PASSWORD=cpgs_dev_password
POSTGRES_DB=cpgs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Application database URL (SQLAlchemy) ---
# Inside docker-compose the api service overrides host to `db`
DATABASE_URL=postgresql+psycopg://cpgs:cpgs_dev_password@localhost:5432/cpgs

# --- Auth (FR-01..04, DESIGN.md §23) ---
JWT_SECRET=dev-only-change-me-generate-a-real-64-char-secret-for-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false              # true in production (HTTPS only)
COOKIE_SAMESITE=lax

# --- First admin seed (FR-04) used by scripts/seed-admin.py ---
ADMIN_EMAIL=admin@cpgs.local
ADMIN_PASSWORD=ChangeMeAdmin!2026
ADMIN_NAME=Platform Admin

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- External AI services (P5/P6 — leave empty until needed) ---
OPENAI_API_KEY=
TAVILY_API_KEY=

# --- Pipeline tunables (DESIGN.md §11.3) ---
MAX_CANDIDATES_PER_RUN=30
MAX_EVALUATIONS_PER_RUN=18
EVAL_BATCH_SIZE=4
DEDUP_COSINE_THRESHOLD=0.92
RUN_CONCURRENCY=2
LLM_MONTHLY_BUDGET_USD=50
DISABLE_AI_PIPELINE=false

# --- Observability (P7 activation; keys optional in P1) ---
SENTRY_DSN_API=
SENTRY_DSN_WEB=
LOG_LEVEL=INFO
